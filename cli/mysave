#!/usr/bin/env bash
# mysave - Fast capture CLI for mygoogle

set -e

HOST="${MYGOOGLE_HOST:-127.0.0.1}"
PORT="${MYGOOGLE_PORT:-7474}"
API_URL="http://${HOST}:${PORT}/api/ingest"

TYPE=""
TITLE=""
PAYLOAD=""
CONTEXT=""
SOURCE_URL=""
NOTES=""
TAGS=""
AUTO_SCRAPE="true"

show_help() {
    cat << EOF
mysave - Quick capture CLI for mygoogle

Usage:
  mysave -c <command> -t <title> [-g tags] [-n notes]
  mysave -u <url> -t <title> [-n notes] [-g tags]
  mysave -q <quote> -t <title> [-u source_url]
  mysave -p <payload> --type <type> -t <title>
  echo "command" | mysave -c -t <title>

Options:
  -c, --cmd, --command <cmd>    Save a shell command or script
  -u, --url <url>               Save a bookmark / web link
  -q, --quote <text>            Save a highlighted quote or snippet
  -p, --payload <text>          Generic payload text
  --type <type>                 Item type: command | snippet | bookmark | highlight | ai_chat | note
  -t, --title <title>           Title or description
  -n, --notes <notes>           Additional notes or explanation
  -g, --tags <tags>             Comma-separated tags
  --context <context>           Environment context (e.g. OS, project)
  --no-scrape                   Disable auto web scraping for URLs
  -h, --help                    Show this help message
EOF
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--cmd|--command)
            TYPE="command"
            if [[ -n "$2" && "$2" != -* ]]; then
                PAYLOAD="$2"
                shift 2
            else
                shift 1
            fi
            ;;
        -u|--url)
            TYPE="bookmark"
            SOURCE_URL="$2"
            PAYLOAD="$2"
            shift 2
            ;;
        -q|--quote)
            TYPE="highlight"
            PAYLOAD="$2"
            shift 2
            ;;
        -p|--payload)
            PAYLOAD="$2"
            shift 2
            ;;
        --type)
            TYPE="$2"
            shift 2
            ;;
        -t|--title)
            TITLE="$2"
            shift 2
            ;;
        -n|--notes)
            NOTES="$2"
            shift 2
            ;;
        -g|--tags)
            TAGS="$2"
            shift 2
            ;;
        --context)
            CONTEXT="$2"
            shift 2
            ;;
        --no-scrape)
            AUTO_SCRAPE="false"
            shift 1
            ;;
        -h|--help)
            show_help
            ;;
        *)
            if [[ -z "$TITLE" ]]; then
                TITLE="$1"
            elif [[ -z "$PAYLOAD" ]]; then
                PAYLOAD="$1"
            fi
            shift 1
            ;;
    esac
done

# Read from stdin if payload is empty and stdin is piped
if [[ -z "$PAYLOAD" && ! -t 0 ]]; then
    PAYLOAD=$(cat)
fi

if [[ -z "$TYPE" ]]; then
    TYPE="note"
fi

if [[ -z "$TITLE" ]]; then
    if [[ -n "$PAYLOAD" ]]; then
        # Default title to first 50 chars of payload
        TITLE=$(echo "$PAYLOAD" | head -n 1 | cut -c 1-50)
    else
        echo "Error: Missing required title or payload."
        exit 1
    fi
fi

if [[ -z "$PAYLOAD" ]]; then
    PAYLOAD="$TITLE"
fi

# Build JSON payload using jq
JSON_DATA=$(jq -n \
    --arg type "$TYPE" \
    --arg title "$TITLE" \
    --arg payload "$PAYLOAD" \
    --arg context "$CONTEXT" \
    --arg source_url "$SOURCE_URL" \
    --arg notes "$NOTES" \
    --arg tags "$TAGS" \
    --argjson auto_scrape "$AUTO_SCRAPE" \
    '{
        type: $type,
        title: $title,
        payload: $payload,
        context: (if $context == "" then null else $context end),
        source_url: (if $source_url == "" then null else $source_url end),
        notes: (if $notes == "" then null else $notes end),
        tags: (if $tags == "" then null else $tags end),
        auto_scrape: $auto_scrape
    }')

# Send request to daemon
HTTP_RESPONSE=$(curl -s -w "\n%{http_code}" -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -d "$JSON_DATA" 2>/dev/null || true)

HTTP_BODY=$(echo "$HTTP_RESPONSE" | sed '$d')
HTTP_STATUS=$(echo "$HTTP_RESPONSE" | tail -n 1)

if [[ "$HTTP_STATUS" == "200" ]]; then
    ITEM_ID=$(echo "$HTTP_BODY" | jq -r '.id')
    echo "[OK] Ingested [$TYPE]: '$TITLE' (id: $ITEM_ID)"
else
    if [[ -z "$HTTP_STATUS" || "$HTTP_STATUS" == "000" ]]; then
        echo "Error: mygoogle daemon is not running on $HOST:$PORT"
        echo "Start it with: python -m backend.app (or uvicorn backend.app:app --port $PORT)"
    else
        echo "Error ($HTTP_STATUS): $HTTP_BODY"
    fi
    exit 1
fi
