[Unit]
Description=Amber Personal Memory Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/projects/amber
ExecStart=%h/Documents/projects/amber/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 7474
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
