# =============================================================================
# Amber - Configuration Reference (.env)
# =============================================================================

# Server settings
AMBER_HOST=127.0.0.1
AMBER_PORT=7474

# Data storage path (defaults to ~/.local/share/amber/db.sqlite)
# AMBER_DATA_DIR=/home/user/.local/share/amber
# AMBER_DB_PATH=/home/user/.local/share/amber/db.sqlite

# Embedding Model (ONNX CPU via FastEmbed)
AMBER_EMBED_MODEL=BAAI/bge-small-en-v1.5
AMBER_EMBED_DIM=384
AMBER_EMBED_TRUNCATE_CHARS=2000

# Idle memory sleep: seconds of inactivity before unloading model from RAM
# 300 = 5 minutes (default), 0 = immediate detach, -1 = never unload (pinned)
AMBER_MODEL_IDLE_TIMEOUT_SEC=300

# -----------------------------------------------------------------------------
# Search & Ranking Hyperparameters
# -----------------------------------------------------------------------------

# Minimum cosine similarity required for vector candidates (0.0 to 1.0)
AMBER_MIN_SIMILARITY=0.62

# Reciprocal Rank Fusion constant k (default: 60)
AMBER_RRF_K=60

# Vector score weighting exponent (default: 2.0)
AMBER_VECTOR_EXPONENT=2.0

# Exact & Substring match score bonuses
AMBER_EXACT_MATCH_BONUS=0.08
AMBER_SUBSTRING_MATCH_BONUS=0.04

# Usage frequency boost: score += USAGE_BOOST * ln(1 + use_count)
AMBER_USAGE_BOOST=0.015

# FTS5 BM25 Field Weights (title, payload, tags, notes, raw_content)
AMBER_BM25_W_TITLE=5.0
AMBER_BM25_W_PAYLOAD=10.0
AMBER_BM25_W_TAGS=3.0
AMBER_BM25_W_NOTES=2.0
AMBER_BM25_W_RAW=1.0

# Candidate limits
AMBER_FTS_CANDIDATE_LIMIT=50
AMBER_VECTOR_CANDIDATE_LIMIT=50

# Snippet word counts in FTS previews
AMBER_SNIPPET_WORDS_TITLE=16
AMBER_SNIPPET_WORDS_PAYLOAD=24

# -----------------------------------------------------------------------------
# Database & Pagination Limits
# -----------------------------------------------------------------------------
AMBER_DB_TIMEOUT_SEC=10.0
AMBER_DB_BUSY_TIMEOUT_MS=5000
AMBER_DEFAULT_SEARCH_LIMIT=20
AMBER_MAX_SEARCH_LIMIT=100
AMBER_DEFAULT_ITEMS_LIMIT=50
AMBER_MAX_ITEMS_LIMIT=200
