# =============================================================================
# mygoogle - Configuration Reference (.env)
# =============================================================================

# Server settings
MYGOOGLE_HOST=127.0.0.1
MYGOOGLE_PORT=7474

# Data storage path (defaults to ~/.local/share/mygoogle/db.sqlite)
# MYGOOGLE_DATA_DIR=/home/user/.local/share/mygoogle
# MYGOOGLE_DB_PATH=/home/user/.local/share/mygoogle/db.sqlite

# Embedding Model (ONNX CPU via FastEmbed)
MYGOOGLE_EMBED_MODEL=BAAI/bge-small-en-v1.5
MYGOOGLE_EMBED_DIM=384
MYGOOGLE_EMBED_TRUNCATE_CHARS=2000

# -----------------------------------------------------------------------------
# Search & Ranking Hyperparameters
# -----------------------------------------------------------------------------

# Minimum cosine similarity required for vector candidates (0.0 to 1.0)
MYGOOGLE_MIN_SIMILARITY=0.62

# Reciprocal Rank Fusion constant k (default: 60)
MYGOOGLE_RRF_K=60

# Vector score weighting exponent (default: 2.0)
MYGOOGLE_VECTOR_EXPONENT=2.0

# Exact & Substring match score bonuses
MYGOOGLE_EXACT_MATCH_BONUS=0.08
MYGOOGLE_SUBSTRING_MATCH_BONUS=0.04

# Usage frequency boost: score += USAGE_BOOST * ln(1 + use_count)
MYGOOGLE_USAGE_BOOST=0.015

# FTS5 BM25 Field Weights (title, payload, tags, notes, raw_content)
MYGOOGLE_BM25_W_TITLE=5.0
MYGOOGLE_BM25_W_PAYLOAD=10.0
MYGOOGLE_BM25_W_TAGS=3.0
MYGOOGLE_BM25_W_NOTES=2.0
MYGOOGLE_BM25_W_RAW=1.0

# Candidate limits
MYGOOGLE_FTS_CANDIDATE_LIMIT=50
MYGOOGLE_VECTOR_CANDIDATE_LIMIT=50

# Snippet word counts in FTS previews
MYGOOGLE_SNIPPET_WORDS_TITLE=16
MYGOOGLE_SNIPPET_WORDS_PAYLOAD=24

# -----------------------------------------------------------------------------
# Database & Pagination Limits
# -----------------------------------------------------------------------------
MYGOOGLE_DB_TIMEOUT_SEC=10.0
MYGOOGLE_DB_BUSY_TIMEOUT_MS=5000
MYGOOGLE_DEFAULT_SEARCH_LIMIT=20
MYGOOGLE_MAX_SEARCH_LIMIT=100
MYGOOGLE_DEFAULT_ITEMS_LIMIT=50
MYGOOGLE_MAX_ITEMS_LIMIT=200
